{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 0,

    "modules-left": ["clock", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["network", "battery"],

    "clock": {
        "format": "{:%H:%M}",
        "interval": 1
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{}"
    },

    "network": {
    "format-wifi": "󰤨 ",
    "format-ethernet": "󰤨 ",
    "format-disconnected": "",
    "tooltip": false
},

    "battery": {
        "format": "{capacity}%",
        "format-charging": "{capacity}!",
        "format-plugged": "{capacity}!",
        "tooltip": false
    }
}